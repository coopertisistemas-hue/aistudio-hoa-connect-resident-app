# HOA Connect — Resident App
# Copy this file to .env and fill in the values.
# This repository must contain ONLY browser-safe variables.
# NEVER commit service-role keys, SMTP passwords, or third-party API secrets here.

# Supabase project configuration (browser-safe — anon key is public by design)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Application metadata
VITE_APP_NAME="HOA Connect"
VITE_APP_VERSION=0.0.0
