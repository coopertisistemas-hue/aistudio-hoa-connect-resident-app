{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit --project tsconfig.app.json",
    "typecheck": "npm run type-check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test:sprint1": "bash -lc 'docker exec -i supabase_db_aistudio-hoa-connect-resident-app psql -U postgres -d postgres < supabase/tests/sprint01_foundation.sql'",
    "supabase:test:d2": "bash validation/run_d2_regression.sh",
    "supabase:test:all": "npm run supabase:test:sprint1 && npm run supabase:test:edge-func-auth && npm run supabase:test:d2 && npm run supabase:test:sprint1",
    "supabase:test:edge-func-auth": "bash -lc 'docker exec -i supabase_db_aistudio-hoa-connect-resident-app psql -U postgres -d postgres < supabase/tests/sprint01_edge_function_fixtures.sql' && node supabase/tests/sprint01_edge_function_auth.test.mjs",
    "supabase:perf:seed": "bash -lc 'docker exec -i supabase_db_aistudio-hoa-connect-resident-app psql -U postgres -d postgres < supabase/tests/sprint01_performance_seed.sql'",
    "supabase:perf:explain": "bash -lc 'docker exec -i supabase_db_aistudio-hoa-connect-resident-app psql -U postgres -d postgres < supabase/tests/sprint01_performance_explain.sql'",
    "supabase:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "i18next": "^25.3.2",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-i18next": "^15.6.0",
    "react-router-dom": "^7.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "firebase": "12.0.0",
    "@supabase/supabase-js": "2.57.4",
    "@stripe/react-stripe-js": "4.0.2",
    "recharts": "3.2.0",
    "lucide-react": "^0.469.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.0.1",
    "unplugin-auto-import": "^19.3.0",
    "source-map": "^0.7.6",
    "jiti": "^2.6.1"
  }
}
